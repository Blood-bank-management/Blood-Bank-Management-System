# Copy this file to .env and fill in real values for your machine. Never
# commit the real .env file (it is already in .gitignore).
#
# This project does not use a .env-loading library (no new dependency was
# added for Sprint 2); export these as real environment variables before
# running manage.py, e.g.:
#   export $(grep -v '^#' .env | xargs)   # bash/zsh, from the repo root

# A long, random, secret string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-this-to-a-real-secret-before-any-shared-deployment

# "True" for local development, "False" everywhere else.
DJANGO_DEBUG=True

# Comma-separated list of hostnames the app is allowed to serve.
# Example for a shared dev server: DJANGO_ALLOWED_HOSTS=dev.example.com,localhost
DJANGO_ALLOWED_HOSTS=
